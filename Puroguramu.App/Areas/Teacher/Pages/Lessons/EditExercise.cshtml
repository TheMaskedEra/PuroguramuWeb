@page
@model Puroguramu.App.Areas.Teacher.Pages.Lessons.EditExercise

@{
    ViewData["Title"] = "Exercice";
    ViewData["PageTitle"] = "Édition de l'exercice";
}

<section class="w-3/4 mx-auto">
    <form class="space-y-4 md:space-y-6 w-3/4 my-10 mx-auto flex flex-col items-center" method="post">
        <div asp-validation-summary="ModelOnly" class="text-red-500"></div>
        
        <div class="w-3/4 mx-auto">
            <label asp-for="Input.Title" class="block mb-2 text-sm font-medium">
                Titre de l'exercice <span class="text-red-500">*</span>
            </label>
            <input asp-for="Input.Title"
                   class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-md focus:ring-blue-600 focus:border-blue-600 block w-full p-2.5"
                   placeholder="Titre de l'exercice"
                   aria-required="true"
                   value="@Model.Input.Title"/>
            <span asp-validation-for="Input.Title" class="text-sm text-red-500"></span>
        </div>

        <div class="w-full">
            <label asp-for="Input.Description" class="block mb-2 text-sm font-medium">
                Énoncé de l'exercice <span class="text-red-500">*</span>
            </label>
            <textarea asp-for="Input.Description"
                      class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-md focus:ring-blue-600 focus:border-blue-600 block w-full p-2.5"
                      rows="5"
                      placeholder="Énoncé de l'exercice"
                      aria-required="true">@Model.Input.Description</textarea>
            <span asp-validation-for="Input.Description" class="text-sm text-red-500"></span>
        </div>

        <div class="w-full">
            <label asp-for="Input.Model" class="block mb-2 text-sm font-medium">
                Modèle de l'exercice <span class="text-red-500">*</span>
            </label>
            <div id="ProposalEditor" class="-z-10 w-full m-auto h-[50vh] rounded-md">@Model.Input.Model</div>
            <input asp-for="Input.Model" id="Model" type="hidden" value="@Model.Input.Model"/>
            <span asp-validation-for="Input.Model" class="text-sm text-red-500"></span>
        </div>

        <div class="w-full">
            <label asp-for="Input.Answer" class="block mb-2 text-sm font-medium">
                Réponse de l'exercice <span class="text-red-500">*</span>
            </label>
            <div id="ProposalAnswerEditor" class="-z-10 w-full m-auto h-[50vh] rounded-md">@Model.Input.Answer</div>
            <input asp-for="Input.Answer" id="Answer" type="hidden" value="@Model.Input.Answer"/>
            <span asp-validation-for="Input.Answer" class="text-sm text-red-500"></span>
        </div>

        <button id="exercise-submit"
                type="submit"
                class="w-1/2 text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-md text-sm px-5 py-2.5 text-center">
            Sauvegarder les modifications
        </button>
    </form>
</section>

<script defer src="~/js/loadEditor.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.3/ace.js" integrity="sha512-hWCQiPFpU0dM1jkN2dkt/OrdSXO4KN5y2utMvF0ZkacWmRvbOlEygqBW0YiJwq/nn6iywh4XnMGMG6ESQYM7WA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
