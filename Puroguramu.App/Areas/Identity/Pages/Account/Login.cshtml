@page
@model LoginModel

@{
    ViewData["Title"] = "Connexion";
    ViewData["PageTitle"] = "Connexion à votre compte";
}

<section class="w-1/2 mx-auto">
    <form class="space-y-4 md:space-y-6 w-3/4 my-10 mx-auto" id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-red-500"></div>
        <div>
            <label asp-for="Input.UserName" class="block mb-2 text-sm font-medium">
                Email ou Matricule <span class="text-red-500">*</span>
            </label>
            <input asp-for="Input.UserName"
                   class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-md focus:ring-blue-600 focus:border-blue-600 block w-full p-2.5"
                   placeholder="name@company.com"
                   autocomplete="username" 
                   aria-required="true" />
            <span asp-validation-for="Input.UserName" class="text-sm text-red-500"></span>
        </div>
        
        <div>
            <label asp-for="Input.Password" class="block mb-2 text-sm font-medium">
                Mot de passe <span class="text-red-500">*</span>
            </label>
            <div class="relative">
                <input asp-for="Input.Password"
                       id="password"
                       class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-md focus:ring-blue-600 focus:border-blue-600 block w-full p-2.5"
                       placeholder="••••••••"
                       autocomplete="current-password" 
                       aria-required="true" />
                <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-900 hover:text-black focus:text-black focus:outline-none">
                    <span id="eyeIconPassword" class="material-symbols-outlined">visibility_off</span>
                </button>
            </div>
            <span asp-validation-for="Input.Password" class="text-sm text-red-500"></span>
        </div>
        
        <div class="flex items-start">
            <div class="flex items-center h-5">
                <input asp-for="Input.RememberMe" aria-describedby="remember" type="checkbox" class="w-4 h-4 border border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-blue-300">
            </div>
            <div class="ml-3 text-sm">
                <label asp-for="Input.RememberMe">Se souvenir de moi</label>
            </div>
        </div>
        
        <button id="login-submit"
                type="submit"
                class="w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-md text-sm px-5 py-2.5 text-center">
            Connexion
        </button>
        
        <p class="text-sm font-light text-gray-500 dark:text-gray-400">
            Pas encore de compte? 
            <a asp-area="Identity" asp-page="/Account/Register" class="font-medium text-blue-600 hover:underline">
                S'inscrire
            </a>
        </p>
    </form>
</section>

<script src="~/js/passwordUtils.js" defer></script>

