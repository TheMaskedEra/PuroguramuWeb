@page
@model LockoutModel
@{
    ViewData["Title"] = "Verrouillé";
    ViewData["PageTitle"] = "Ce compte a été verrouillé";
}

<section class="w-1/2 mx-auto flex flex-col items-center">
    <p class="text-center mt-10">
        Votre compte a été verrouillé pour des raisons de sécurité. <br/> 
        Veuillez réessayer dans quelques minutes.
    </p>
    
    <p class="text-center my-10">
        Pour retourner à la page d'accueil, cliquez sur ce bouton.
    </p>
    
    <a asp-area="" 
       asp-page="/Index"
       class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-md text-sm px-5 py-2.5 text-center">
        Retour a l'accueil
    </a>
</section>
