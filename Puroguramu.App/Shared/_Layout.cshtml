<!DOCTYPE html>

<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/styles.css" />
    <title>@RenderSection("Title", true)</title>
</head>

<body class="w-full min-h-screen flex flex-col">

<header class="w-full">
    <nav class="mx-5 flex justify-between items-center">
        
        <span class="flex gap-1 items-center">
            <img class="h-16" src="~/assets/icon.png" alt="app logo">
            <h1 class="text-2xl font-semibold">Puroguramu</h1>
        </span>
        
        <ul class="flex gap-4">
            <li>Accueil</li>
            <li>Profil</li>
            <li>Paramètres</li>
            <li>À propos</li>
        </ul>
        
    </nav>
</header>

<main class="m-5">
    @RenderBody()
</main>

<footer class="w-full mt-auto">
    <p class="w-fit mx-auto py-5">Vullo Enzo - Vanden Broeck Alexis &copy; 2024 Puroguramu</p>
</footer>

</body>
</html>