@page
@model Puroguramu.App.Pages.User.ProfileModel

@{
    ViewData["Title"] = "Profil";
    ViewData["PageTitle"] = "Modifier votre profil";
}

<section class="w-1/2 mx-auto">
    <form class="space-y-4 md:space-y-6 w-3/4 my-10 mx-auto" method="post">
        <div>
            <label for="avatar" class="block mb-2 text-sm font-medium">Photo de profil</label>
            
            <div class="w-full flex items-center justify-between">
                <img id="preview_img" 
                     class="mx-auto h-20 w-20 rounded-full object-cover bg-white border-2 border-blue-600"
                     src="~/assets/default.png" 
                     alt="current profile pictures"/>
                
                <input class="w-1/2 text-sm text-slate-500
                    hover:file:cursor-pointer
                    file:mx-2 file:p-2
                    file:rounded-md file:border-0
                    file:text-sm file:bg-blue-50 
                    file:text-blue-600 hover:file:bg-blue-100" 
                    type="file" id="avatar" name="avatar"
                    onchange="loadFile(event)"/>
            </div> 
        </div>
        
        <div class="w-full flex items-center justify-between">
            <div class="w-1/2 mr-1">
                <label for="name" class="block mb-2 text-sm font-medium">Nom</label>
                <input type="text" name="name" id="name" class="w-full bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-md focus:ring-blue-600 focus:border-blue-600 block p-2.5" placeholder="Doe" required>
            </div>
            <div class="w-1/2 ml-2">
                <label for="firstname" class="block mb-2 text-sm font-medium">Prénom</label>
                <input type="text" name="firstname" id="firstname" class="w-full bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-md focus:ring-blue-600 focus:border-blue-600 block p-2.5" placeholder="John" required>
            </div>
        </div>

        <div>
            <label for="email" class="block mb-2 text-sm font-medium">Email</label>
            <input type="email" name="email" id="email" class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-md focus:ring-blue-600 focus:border-blue-600 block w-full p-2.5" placeholder="name@company.com" required>
        </div>
        <div>
            <label for="password" class="block mb-2 text-sm font-medium">Mot de passe</label>
            <input type="password" name="password" id="password" class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-md focus:ring-blue-600 focus:border-blue-600 block w-full p-2.5" placeholder="••••••••" required>
        </div>
        <div>
            <label for="passwordConf" class="block mb-2 text-sm font-medium">Confirmation du mot de passe</label>
            <input type="password" name="passwordConf" id="passwordConf" class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-md focus:ring-blue-600 focus:border-blue-600 block w-full p-2.5" placeholder="••••••••" required>
        </div>

        <div class="w-full flex items-center justify-between">
            <label for="group" class="block mb-2 text-sm font-medium">Groupe</label>
            <select name="group" id="group" class="w-1/3 bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-md focus:ring-blue-600 focus:border-blue-600 block p-2.5" required>
                <option value="2i1">2i1</option>
                <option value="2i2">2i2</option>
                <option value="2i3">2i3</option>
                <option value="2i4">2i4</option>
            </select>
        </div>

        <button type="submit" class="w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-md text-sm px-5 py-2.5 text-center">Valider les modifications</button>
    </form>
</section>

<script src="~/js/utils.js"></script>