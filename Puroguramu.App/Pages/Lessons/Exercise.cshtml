@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Puroguramu.App.Pages
@model Puroguramu.App.Pages.ExerciseModel

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Exercice 1";
}

@* TODO: button and logic to view solution *@
<h2 class="w-fit mx-auto text-center text-2xl font-semibold">Exercice 1</h2>

<section class="w-3/4 mx-auto">
    <p class="my-5 w-3/4 mx-auto text-center">
        Créez une fonction <code>Power</code> C# prenant en paramètre
        une base <em>b</em> de type <code>float</code> et un exposant <em>e</em> de type <code>int</code>.
        <code>Power(b, e)</code> retourne le <code>float</code> <em>b</em><sup><em>e</em></sup>.
    </p>
    
    <form method="post" class="w-3/4 mx-auto">
        <div>
            <div class="mb-2">
                <span>Difficulté: </span>
                <strong>Easy</strong>
            </div>
            <div class="mb-2">
                <span>Status: </span>
                <strong>@Model.ExerciseResultStatus</strong>
            </div>
            <div>
                <div id="ProposalEditor" class="w-full m-auto h-[50vh] rounded-md">@Model.Proposal</div>
                <button class="px-2 py-1 my-4 ml-auto w-fit rounded-md text-white bg-blue-500 hover:bg-blue-600">
                    Exécuter
                </button>
                <input asp-for="Proposal" type="hidden" />
                
                <div>
                    <h4>Résultats</h4>
                    @foreach (var testResult in Model.TestResult)
                    {
                        <div>
                            <h5><span>@testResult.Status</span>&nbsp;@testResult.Label</h5>
                            @if (testResult.HasError)
                            {
                                <p class="text-red-500">@testResult.ErrorMessage</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </form>
</section>

<script defer src="~/js/loadEditor.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.3/ace.js" integrity="sha512-hWCQiPFpU0dM1jkN2dkt/OrdSXO4KN5y2utMvF0ZkacWmRvbOlEygqBW0YiJwq/nn6iywh4XnMGMG6ESQYM7WA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

