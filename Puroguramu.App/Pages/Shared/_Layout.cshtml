<!DOCTYPE html>

<html lang="fr" class="bg-gradient-to-tr from-slate-900 from-75% via-blue-900 via-85% to-slate-900 to-95% backdrop-blur-xl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/input.css" asp-append-version="true" />
    <title>@ViewData["Title"] - Puroguramu</title>
</head>

<body class="w-full min-h-screen flex flex-col text-white overscroll-none">

<header class="w-full fixed top-0 backdrop-blur-md">
    <nav class="mx-5 flex justify-between items-center">
        
        <span class="flex gap-1 items-center">
            <img class="h-16" src="~/assets/icon.png" alt="app logo">
            <h1 class="text-lg md:text-2xl font-semibold">Puroguramu</h1>
        </span>
        
        <ul class="flex">
            <li class="px-4">
                <a asp-page="/User/Dashboard" class="cursor-pointer flex items-center">
                    <span class="material-symbols-outlined px-2">
                        space_dashboard
                    </span>
                    <p class="relative after:block after:content-[''] after:absolute after:bottom-0 after:h-[3px] after:bg-white after:w-full after:scale-x-0 after:hover:scale-x-100 after:transition after:duration-300 after:origin-center">
                        Tableau de bord
                    </p>
                </a>
            </li>
            <li class="px-4">
                <a asp-page="/User/Profile" class="cursor-pointer relative flex items-center">
                    <span class="material-symbols-outlined px-2">
                        manage_accounts
                    </span>
                    <p class="relative after:block after:content-[''] after:absolute after:bottom-0 after:h-[3px] after:bg-white after:w-full after:scale-x-0 after:hover:scale-x-100 after:transition after:duration-300 after:origin-center">
                        Paramètres
                    </p>
                </a>
            </li>
        </ul>
    </nav>
    <hr class="w-full border-t-1 border-gray-400" />
</header>

<main class="mt-24 mx-5 mb-10">
    @await RenderSectionAsync("PageImage", required: false)
    
    <h2 class="w-fit mx-auto text-center text-2xl font-semibold">@Html.Raw(ViewData["PageTitle"])</h2>

    @RenderBody()
</main>

<footer class="w-full mt-auto">
    <hr class="w-full border-t-1 border-gray-400" />
    <p class="text-center w-10/12 md:w-fit mx-auto py-5">Vullo Enzo - Vanden Broeck Alexis <br/> &copy; <br/> 2024 Puroguramu</p>
</footer>
</body>
</html>