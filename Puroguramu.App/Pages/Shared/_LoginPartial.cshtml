@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Puroguramu.Infrastructures.Data.Entities

@inject SignInManager<Users> SignInManager
@inject UserManager<Users> UserManager

<ul class="flex">
@if (SignInManager.IsSignedIn(User))
{
    <li class="px-4">
        <a asp-area="User" asp-page="/Lessons/Dashboard" class="cursor-pointer flex items-center">
            <span class="material-symbols-outlined px-2">
                space_dashboard
            </span>
            <p class="relative after:block after:content-[''] after:absolute after:bottom-0 after:h-[2px] after:bg-white after:w-full after:scale-x-0 after:hover:scale-x-100 after:transition after:duration-300 after:origin-center">
                Tableau de bord
            </p>
        </a>
    </li>
    <li class="px-4">
        <a asp-area="Identity" asp-page="/Account/EditProfile" class="cursor-pointer relative flex items-center">
            <span class="material-symbols-outlined px-2">
                manage_accounts
            </span>
            <p class="relative after:block after:content-[''] after:absolute after:bottom-0 after:h-[2px] after:bg-white after:w-full after:scale-x-0 after:hover:scale-x-100 after:transition after:duration-300 after:origin-center">
                Mon profil
            </p>
        </a>
    </li>
    <li class="px-4">
        <form id="logoutForm" class="cursor-pointer relative flex items-center" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <span class="material-symbols-outlined px-2">
                logout
            </span>
            <button id="logout" type="submit" class="relative after:block after:content-[''] after:absolute after:bottom-0 after:h-[2px] after:bg-white after:w-full after:scale-x-0 after:hover:scale-x-100 after:transition after:duration-300 after:origin-center">
                Déconnexion
            </button>
        </form>
    </li>
}
else
{
    <li class="px-4">
        <a class="cursor-pointer relative flex items-center" id="register" asp-area="Identity" asp-page="/Account/Register">
            <span class="material-symbols-outlined px-2">
                <span class="material-symbols-outlined">
                    how_to_reg
                </span>
            </span>
            <p class="relative after:block after:content-[''] after:absolute after:bottom-0 after:h-[2px] after:bg-white after:w-full after:scale-x-0 after:hover:scale-x-100 after:transition after:duration-300 after:origin-center">
                Inscription
            </p>
        </a>
    </li>
    <li class="nav-item">
        <a class="cursor-pointer relative flex items-center" id="login" asp-area="Identity" asp-page="/Account/Login">
            <span class="material-symbols-outlined px-2">
                login
            </span>
            <p class="relative after:block after:content-[''] after:absolute after:bottom-0 after:h-[2px] after:bg-white after:w-full after:scale-x-0 after:hover:scale-x-100 after:transition after:duration-300 after:origin-center">
                Connexion
            </p>
        </a>
    </li>
}
</ul>
